# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3003

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/dna-encoder

# JWT Configuration (must match user-management service)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Service URLs
OBJECT_STORAGE_URL=http://localhost:3002
USER_MANAGEMENT_URL=http://localhost:3001

# DNA Encoding Configuration
DEFAULT_ENCODING_METHOD=standard
MAX_SEQUENCE_LENGTH=1000000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:8100,capacitor://localhost
